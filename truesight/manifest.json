{
  "manifest_version": 3,
  "name": "TrueSight",
  "version": "1.0",

  "description": "Assignment for 3027ICT",

  "icons": {
    "64": "icons/eye.svg"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "s520128@griffith.edu.au",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "content_scripts": [
    {
      "matches": [ 
    "*://*.mozilla.org/*",
	  "*://*.reddit.com/*",
	  "*://*.x.com/*",
	  "https://www.facebook.com/*",
	  "https://facebook.com/*",
    "https://www.reddit.com/*"	],
      "js": [
        "content.js",
        "storage.js",
        "check.js",
        "modes/x.js",
        "modes/facebook.js"
        ],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
